# Copy to .env (never commit .env). Defaults assume everything Python runs on the Brev box.
# Nothing loads .env by itself: in each terminal, run  set -a; . ./.env; set +a

# Event bus (Mina)
CLARITY_BUS_URL=http://127.0.0.1:8080
CLARITY_BUS_STRICT=1
# A new run id for each take, the same in every terminal (the bus logs to runs/<id>/events.jsonl)
CLARITY_RUN_ID=run_dev
CLARITY_RUNS_DIR=runs
# Live demo site: test clip 1 (cam_07 to cam_10). Clip 8's site (the recorded run runs/run_1018-0028_r2s) is data/sites/annex/cameras.json
CLARITY_CAMERAS=data/sites/annex_clip1/cameras.json
# Three crimes at once (test clips 1, 3 and 7 on one map): CLARITY_CAMERAS=data/sites/annex_trio/cameras.json
# Two full chases at once (test clips 1 and 3 on one map): CLARITY_CAMERAS=data/sites/annex_duo/cameras.json
# Two crimes at once (test clips 1 and 7 on one map): CLARITY_CAMERAS=data/sites/annex_multi/cameras.json
# Clip paths in cameras.json are relative to the repo root (e.g. data/raw/staged/take3/clip1_cam1.mp4), so
# leave CLARITY_CLIP_ROOT unset unless the clips live somewhere else; set it to a folder that contains data/raw/staged/ (the paths are joined to it).
# CLARITY_CLIP_ROOT=

# Model servers on Brev (vLLM, OpenAI-compatible). Bind to 127.0.0.1; reach them via brev port-forward.
# Dispatcher (Michael): Nemotron Nano 9B v2, served as "dispatcher" on :8003 (infra/serve_dispatcher.sh)
CLARITY_LLM_BASE_URL=http://localhost:8003/v1
CLARITY_LLM_MODEL=dispatcher
# If the dispatcher's vLLM server uses --api-key, put the same value here (never in a VITE_ variable)
CLARITY_LLM_API_KEY=EMPTY
# Spotter (Wali): the fine-tuned Qwen3-VL-2B, served as "spotter-ft" on :8005 (src/spotter.py). It decides crime + type.
# The base model (Qwen/Qwen3-VL-2B-Instruct on :8001) is only for the before/after comparison.
SPOTTER_URL=http://localhost:8005/v1
SPOTTER_MODEL=spotter-ft
# Checker (Wali): Nemotron Nano 12B v2 VL, served as "checker" on :8002 (src/checker.py). It describes the suspect
# on the cameras the spotter flagged; python -m agents.run --live calls it (--no-checker runs the spotter alone).
CHECKER_BASE_URL=http://localhost:8002/v1
CHECKER_MODEL=checker

# Hugging Face (only if a download needs it)
HF_TOKEN=

# Dashboard (Mina's laptop; put in dashboard/.env). VITE_ variables are bundled into the page: never put secrets in them.
VITE_BUS_URL=http://127.0.0.1:8080
