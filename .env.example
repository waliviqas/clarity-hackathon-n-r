# Copy to .env (never commit .env). Defaults assume everything Python runs on the Brev box.

# Event bus (Mina)
CLARITY_BUS_URL=http://127.0.0.1:8080
CLARITY_BUS_STRICT=1
CLARITY_RUN_ID=run_dev
CLARITY_RUNS_DIR=runs
# Placeholder site for the scripted run; the real clip-8 site is data/sites/annex/cameras.json
CLARITY_CAMERAS=data/sites/annex_placeholder/cameras.json
# Clip paths in cameras.json are relative to the repo root (e.g. data/raw/staged/take1/clip8_cam1.mp4), so
# leave CLARITY_CLIP_ROOT unset unless the clips live somewhere else; set it to that folder's parent then.
# CLARITY_CLIP_ROOT=

# Model servers on Brev (vLLM, OpenAI-compatible). Bind to 127.0.0.1; reach them via brev port-forward.
# Dispatcher (Michael): Nemotron Nano 9B v2, served as "dispatcher" on :8003 (see dispatcher/README.md)
CLARITY_LLM_BASE_URL=http://localhost:8003/v1
CLARITY_LLM_MODEL=dispatcher
# If a vLLM server uses --api-key, put the same value here (never in a VITE_ variable)
CLARITY_LLM_API_KEY=EMPTY
# Spotter (Wali): Qwen3-VL-2B on :8001 (src/spotter.py). Set SPOTTER_MODEL to the fine-tuned model's served name.
SPOTTER_URL=http://localhost:8001/v1
SPOTTER_MODEL=Qwen/Qwen3-VL-2B-Instruct
# Checker (Nemotron Nano 12B v2 VL) on :8002: only if it is served (not confirmed yet)
CHECKER_BASE_URL=http://localhost:8002/v1
CHECKER_MODEL=checker

# Hugging Face (only if a download needs it)
HF_TOKEN=

# Dashboard (Mina's laptop; put in dashboard/.env). VITE_ variables are bundled into the page: never put secrets in them.
VITE_BUS_URL=http://127.0.0.1:8080
