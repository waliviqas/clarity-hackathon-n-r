# Copy to .env (never commit .env). Defaults assume everything Python runs on the Brev box.

# Event bus (Mina)
CLARITY_BUS_URL=http://127.0.0.1:8080
CLARITY_BUS_STRICT=1
CLARITY_RUN_ID=run_dev
CLARITY_CAMERAS=data/cameras.json

# Model servers on Brev (Michael). Bind to 127.0.0.1; reach them via brev port-forward.
DISPATCHER_BASE_URL=http://localhost:8000/v1
DISPATCHER_MODEL=dispatcher
SPOTTER_BASE_URL=http://localhost:8001/v1
SPOTTER_MODEL=spotter
CHECKER_BASE_URL=http://localhost:8002/v1
CHECKER_MODEL=checker
EMBED_BASE_URL=http://localhost:8003
RERANK_BASE_URL=http://localhost:8004
# If the vLLM servers use --api-key, put the same value here (never in a VITE_ variable)
OPENAI_API_KEY=EMPTY

# Hugging Face (only if a download needs it)
HF_TOKEN=

# Dashboard (Mina's laptop; put in dashboard/.env). VITE_ variables are bundled into the page: never put secrets in them.
VITE_BUS_URL=http://127.0.0.1:8080
